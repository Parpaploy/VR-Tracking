rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function activeUser() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'active';
    }

    function admin() {
      return activeUser()
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function imageOk(data) {
      return data is string
        && data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')
        && data.size() <= 700000;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();

      allow create: if (
          admin()
          && request.resource.data.keys().hasAll([
            'name', 'nickname', 'studentId', 'studentEmail',
            'phone', 'role', 'status'
          ])
          && request.resource.data.role in ['user', 'admin']
        ) || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == 'user'
          && request.resource.data.status == 'active'
          && request.resource.data.keys().hasAll([
            'name', 'nickname', 'studentId', 'studentEmail',
            'phone', 'role', 'status'
          ])
        );

      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name', 'nickname', 'studentId', 'studentEmail',
            'phone', 'role', 'status', 'updatedAt'
          ]);
      allow delete: if false;
    }

    match /registrationStudentIds/{claim} {
      allow get: if admin()
        || (signedIn() && (
          !exists(/databases/$(database)/documents/registrationStudentIds/$(claim))
          || resource.data.userId == request.auth.uid
        ));
      allow list: if admin();
      allow create: if admin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && getAfter(userPath(request.auth.uid)).data.role == 'user');
      allow update, delete: if admin();
    }

    match /registrationStudentEmails/{claim} {
      allow get: if admin()
        || (signedIn() && (
          !exists(/databases/$(database)/documents/registrationStudentEmails/$(claim))
          || resource.data.userId == request.auth.uid
        ));
      allow list: if admin();
      allow create: if admin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && getAfter(userPath(request.auth.uid)).data.role == 'user');
      allow update, delete: if admin();
    }

    match /registrationPhones/{claim} {
      allow get: if admin()
        || (signedIn() && (
          !exists(/databases/$(database)/documents/registrationPhones/$(claim))
          || resource.data.userId == request.auth.uid
        ));
      allow list: if admin();
      allow create: if admin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && getAfter(userPath(request.auth.uid)).data.role == 'user');
      allow update, delete: if admin();
    }

    match /registrationDocuments/{uid} {
      allow read: if admin();
      allow create, update: if (
          admin()
          || (signedIn()
            && request.auth.uid == uid
            && getAfter(userPath(uid)).data.role == 'user')
        )
        && request.resource.data.ownerId == uid
        && imageOk(request.resource.data.image);
      allow delete: if admin();
    }

    match /loanPhotos/{loanId} {
      allow read: if admin();
      allow create: if activeUser()
        && getAfter(/databases/$(database)/documents/loans/$(loanId)).data.borrowerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/loans/$(loanId)).data.status == 'pending_approval'
        && request.resource.data.ownerId == request.auth.uid
        && imageOk(request.resource.data.image);
      allow update, delete: if false;
    }

    match /loans/{loanId} {
      allow read: if admin()
        || (activeUser() && resource.data.borrowerId == request.auth.uid);

      allow create: if activeUser()
        && get(userPath(request.auth.uid)).data.role == 'user'
        && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'pending_approval'
        && request.resource.data.returnedAt == null
        && request.resource.data.returnedBy == null
        && existsAfter(/databases/$(database)/documents/loanPhotos/$(loanId))
        && getAfter(/databases/$(database)/documents/gas/$(request.resource.data.deviceId)).data.status == 'pending_approval'
        && getAfter(/databases/$(database)/documents/gas/$(request.resource.data.deviceId)).data.pendingLoanId == loanId;

      allow update: if (
          admin()
          && resource.data.status == 'pending_approval'
          && request.resource.data.status == 'borrowed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'borrowedAt', 'approvedAt', 'approvedBy', 'approvalSource'])
          && request.resource.data.approvedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/gas/$(resource.data.deviceId)).data.activeLoanId == loanId
        ) || (
          admin()
          && resource.data.status == 'pending_approval'
          && request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'rejectedAt', 'rejectedBy', 'rejectionReason'])
          && request.resource.data.rejectedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/gas/$(resource.data.deviceId)).data.pendingLoanId == null
          && getAfter(/databases/$(database)/documents/gas/$(resource.data.deviceId)).data.status == 'good'
        ) || (
          admin()
          && resource.data.status == 'borrowed'
          && request.resource.data.status == 'returned'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'returnedAt', 'returnedBy'])
          && request.resource.data.returnedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/gas/$(resource.data.deviceId)).data.activeLoanId == null
        );

      allow delete: if false;
    }

    match /gas/{deviceId} {
      allow read: if activeUser();

      allow create: if admin()
        && request.resource.data.status in ['good', 'damaged', 'minor_damage', 'major_damage']
        && (!('deviceNumber' in request.resource.data) || (request.resource.data.deviceNumber is string && request.resource.data.deviceNumber.size() <= 64))
        && (!('activeLoanId' in request.resource.data) || request.resource.data.activeLoanId == null)
        && (!('pendingLoanId' in request.resource.data) || request.resource.data.pendingLoanId == null);

      allow update: if (
          admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceNumber', 'updatedAt'])
          && request.resource.data.deviceNumber is string
          && request.resource.data.deviceNumber.size() <= 64
        ) || (
          activeUser()
          && get(userPath(request.auth.uid)).data.role == 'user'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'loanStatus', 'activeLoanId', 'pendingLoanId',
              'statusSource', 'statusSetBy', 'statusSetAt',
              'adminBorrowerId', 'adminBorrowerName', 'updatedAt'
            ])
          && (!('activeLoanId' in resource.data) || resource.data.activeLoanId == null)
          && (!('pendingLoanId' in resource.data) || resource.data.pendingLoanId == null)
          && resource.data.status == 'good'
          && request.resource.data.status == 'pending_approval'
          && request.resource.data.activeLoanId == null
          && request.resource.data.pendingLoanId is string
          && request.resource.data.statusSource == 'user_loan'
          && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.pendingLoanId)).data.borrowerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.pendingLoanId)).data.status == 'pending_approval'
          && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.pendingLoanId)).data.deviceId == deviceId
        ) || (
          admin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'loanStatus', 'activeLoanId', 'pendingLoanId',
              'statusSource', 'statusSetBy', 'statusSetAt',
              'adminBorrowerId', 'adminBorrowerName', 'updatedAt'
          ])
          && (!('activeLoanId' in resource.data) || resource.data.activeLoanId == null)
          && (!('pendingLoanId' in resource.data) || resource.data.pendingLoanId == null)
          && request.resource.data.activeLoanId == null
          && request.resource.data.pendingLoanId == null
          && request.resource.data.statusSetBy == request.auth.uid
          && request.resource.data.statusSource == 'admin'
          && (
            request.resource.data.status == 'borrowed'
            ? request.resource.data.loanStatus == 'borrowed'
              && (
                (request.resource.data.adminBorrowerId == null
                  && request.resource.data.adminBorrowerName == null)
                || (request.resource.data.adminBorrowerId is string
                  && request.resource.data.adminBorrowerName is string
                  && exists(userPath(request.resource.data.adminBorrowerId))
                  && get(userPath(request.resource.data.adminBorrowerId)).data.status == 'active')
              )
            : request.resource.data.status in ['good', 'damaged', 'minor_damage', 'major_damage']
              && request.resource.data.adminBorrowerId == null
              && request.resource.data.adminBorrowerName == null
              && request.resource.data.loanStatus in ['available', 'unavailable']
          )
        ) || (
          admin()
          && resource.data.status == 'pending_approval'
          && request.resource.data.status == 'borrowed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'loanStatus', 'activeLoanId', 'pendingLoanId',
              'statusSource', 'statusSetBy', 'statusSetAt',
              'adminBorrowerId', 'adminBorrowerName', 'updatedAt'
            ])
          && request.resource.data.activeLoanId is string
          && request.resource.data.activeLoanId == resource.data.pendingLoanId
          && request.resource.data.pendingLoanId == null
          && request.resource.data.loanStatus == 'borrowed'
          && request.resource.data.statusSource == 'user_loan'
          && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.activeLoanId)).data.status == 'borrowed'
          && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.activeLoanId)).data.approvedBy == request.auth.uid
        ) || (
          admin()
          && resource.data.status == 'pending_approval'
          && request.resource.data.status == 'good'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'loanStatus', 'activeLoanId', 'pendingLoanId',
              'statusSource', 'statusSetBy', 'statusSetAt',
              'adminBorrowerId', 'adminBorrowerName', 'updatedAt'
            ])
          && request.resource.data.activeLoanId == null
          && request.resource.data.pendingLoanId == null
          && request.resource.data.loanStatus == 'available'
          && getAfter(/databases/$(database)/documents/loans/$(resource.data.pendingLoanId)).data.status == 'rejected'
        ) || (
          admin()
          && resource.data.activeLoanId is string
          && request.resource.data.status == 'good'
          && request.resource.data.activeLoanId == null
          && request.resource.data.pendingLoanId == null
          && request.resource.data.loanStatus == 'available'
          && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.status == 'returned'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'loanStatus', 'activeLoanId', 'pendingLoanId',
              'statusSource', 'statusSetBy', 'statusSetAt',
              'adminBorrowerId', 'adminBorrowerName', 'updatedAt'
            ])
        );

      allow delete: if admin()
        && (!('activeLoanId' in resource.data) || resource.data.activeLoanId == null)
        && (!('pendingLoanId' in resource.data) || resource.data.pendingLoanId == null);
    }

    match /transactions/{transactionId} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /trucks/{truckId} {
      allow read: if activeUser();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedUserId']);
      allow create, delete: if false;
    }

    match /stores/{storeId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /warehouses/{warehouseId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
